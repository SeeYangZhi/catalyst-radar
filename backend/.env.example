# Catalyst Radar — env contract.
#
# Only secrets and deployment-specific values live here. Behavioural
# defaults (cadences, thresholds, lookback windows, etc.) live in
# config.py. UI-tunable knobs persist to the `app_config` DB table at
# runtime — edit them via the Alert Settings page after first boot, not
# here.
#
# Copy this file to .env and fill in the placeholders.

# ── Deployment env ───────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── API ──────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_API_URL=http://localhost:8000

# ── PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=radar_user
POSTGRES_PASSWORD=radar_pass
POSTGRES_DB=radar_db
PGPASSWORD=radar_pass
DATABASE_URL=postgresql+asyncpg://radar_user:radar_pass@localhost:5432/radar_db
DATABASE_URL_SYNC=postgresql://radar_user:radar_pass@localhost:5432/radar_db

# ── Redis / Celery ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Alerts ───────────────────────────────────────────────────────────
# IANA timezone for digests, reminders and "today" (e.g. America/New_York).
ALERT_TIMEZONE=UTC

# ── Auth seed ────────────────────────────────────────────────────────
# JWT_SECRET_KEY must be set in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
DEFAULT_ADMIN_EMAIL=admin@radar.local
DEFAULT_ADMIN_PASSWORD=admin123!

# ── External API keys ────────────────────────────────────────────────
# All optional: a sync whose key is missing is skipped. See README
# "Data sources & API keys" for which feature needs which key.
OPENAI_API_KEY=
EODHD_API_KEY=
# CN share-unlock calendar (tushare.pro; free tier is enough).
TUSHARE_API_TOKEN=

# ── Outbound identity ────────────────────────────────────────────────
# SEC EDGAR requires a descriptive User-Agent with a contact address.
SEC_EDGAR_USER_AGENT="Catalyst Radar you@example.com"
# Sent by the public-web scrapers (HKEX, CNINFO, MOPS). Identify your
# deployment honestly and respect each source's terms and rate limits.
SCRAPER_USER_AGENT="CatalystRadar/0.1 (+https://github.com/SeeYangZhi/catalyst-radar)"

# ── Telegram ─────────────────────────────────────────────────────────
# When TELEGRAM_WEBHOOK_URL is set, getUpdates polling is disabled.
# TELEGRAM_WEBHOOK_SECRET is echoed back in the
# X-Telegram-Bot-Api-Secret-Token header so spoofed POSTs are rejected.
TELEGRAM_BOT_TOKEN=
# Comma-separated admin chat ids (your own chat id: message @userinfobot).
# Admins can flip /settings toggles and receive ops/monitoring alerts.
# Empty = every chat is admin (dev only) — always set in production.
TELEGRAM_ADMIN_CHAT_ID=
# false (default): only admin chats can /start and receive alerts.
# true: anyone who finds the bot can subscribe (each with their own
# stars/dismissals) and will see your watchlist + alert stream.
TELEGRAM_OPEN_SUBSCRIBE=false
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ── Error tracking (optional) ────────────────────────────────────────
# Sentry is a no-op unless SENTRY_DSN is set AND the optional dependency
# is installed: `uv sync --extra monitoring`. Captures uncaught API +
# Celery-task errors. The self-monitoring watchdog (stalled-ingestion /
# provider-quota Telegram alerts) needs no DSN — it's on by default.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ── Cloudflare Tunnel (production only) ──────────────────────────────
# Not read by the app or compose. In the example deployment, cloudflared runs
# as a systemd service installed with the tunnel token directly:
#   sudo cloudflared service install <TUNNEL_TOKEN>
# See deploy/README.md.
