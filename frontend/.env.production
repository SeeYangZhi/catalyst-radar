# Next.js inlines NEXT_PUBLIC_* at `next build` time. Setting them as
# runtime container env has no effect on the client bundle, so they live
# in this committed env file (loaded automatically by `next build`).
#
# The dashboard is served same-origin behind nginx in prod, so the API
# lives at /api/v1 relative to whatever public hostname is in use.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_NAME=Catalyst Radar
